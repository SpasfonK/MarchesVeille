<Window x:Class="MarchesVeille.Desktop.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarchesVeille.Desktop"
        Title="Archives DCE" Width="1260" Height="780" MinWidth="900" MinHeight="560"
        Background="{StaticResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" FontSize="15" Padding="8,6" BorderThickness="0" VerticalContentAlignment="Center"
                         ToolTip="Mots, &quot;phrase exacte&quot;, AND / OR / NOT. Cherche dans l'avis, les noms de fichiers et le texte des documents (PDF, Word, Excel…)."
                         TextChanged="OnFilterChanged" KeyDown="OnSearchKeyDown"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="Chercher dans :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="ScopeCombo" Width="190" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Tout"/>
                        <ComboBoxItem Content="Avis (objet, acheteur, réf.)"/>
                        <ComboBoxItem Content="Noms de fichiers"/>
                        <ComboBoxItem Content="Contenu des documents"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Recherche avancée -->
        <Expander Grid.Row="1" Header="Recherche avancée" IsExpanded="True" Margin="0,0,0,8">
            <WrapPanel Margin="0,6,0,0">
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Organisation" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="BuyerBox" Width="190" TextChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Référence" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="RefBox" Width="130" TextChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Type" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="TypeCombo" Width="120" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Tous"/><ComboBoxItem Content="Travaux"/><ComboBoxItem Content="Fournitures"/>
                        <ComboBoxItem Content="Services"/><ComboBoxItem Content="PI"/>
                    </ComboBox></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Région" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="RegionCombo" Width="120" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Toutes"/><ComboBoxItem Content="Grand Est"/>
                    </ComboBox></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Publié du" Foreground="{StaticResource MutedBrush}"/>
                    <DatePicker x:Name="PubFrom" Width="120" SelectedDateChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="au" Foreground="{StaticResource MutedBrush}"/>
                    <DatePicker x:Name="PubTo" Width="120" SelectedDateChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Récupéré du" Foreground="{StaticResource MutedBrush}"/>
                    <DatePicker x:Name="DlFrom" Width="120" SelectedDateChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="au" Foreground="{StaticResource MutedBrush}"/>
                    <DatePicker x:Name="DlTo" Width="120" SelectedDateChanged="OnFilterChanged"/></StackPanel>
                <StackPanel Margin="0,0,14,6"><TextBlock Text="Tri" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="SortCombo" Width="150" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Pertinence"/><ComboBoxItem Content="Publiés récemment"/><ComboBoxItem Content="Récupérés récemment"/>
                    </ComboBox></StackPanel>
                <Button Style="{StaticResource Btn}" Content="Réinitialiser" Click="OnReset" VerticalAlignment="Bottom" Margin="0,0,10,6"/>
                <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"/>
            </WrapPanel>
        </Expander>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEEF2" RowHeaderWidth="0" CanUserAddRows="False"
                      BorderBrush="{StaticResource BorderBrushSoft}" Background="White" SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnOpenArchive">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Publié" Binding="{Binding Published, StringFormat=dd/MM/yyyy}" Width="80" SortMemberPath="Published"/>
                    <DataGridTextColumn Header="Acheteur" Binding="{Binding Buyer}" Width="190">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="2,3"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Objet" Width="*" SortMemberPath="Title">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock TextWrapping="Wrap" Margin="2,3" local:Highlight.Markup="{Binding TitleMarkup}"/></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="90"/>
                    <DataGridTextColumn Header="Fichiers" Binding="{Binding FileCount}" Width="62"/>
                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeLabel}" Width="72" SortMemberPath="SizeBytes"/>
                    <DataGridTextColumn Header="Récupéré" Binding="{Binding Downloaded, StringFormat=dd/MM/yyyy}" Width="80" SortMemberPath="Downloaded"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Sélectionnez une archive"/>
                <TextBlock x:Name="DetailMeta" Grid.Row="1" Margin="0,8,0,8" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <Button x:Name="BtnOpen" Style="{StaticResource AccentBtn}" Content="Ouvrir l'archive" Click="OnOpenArchive" IsEnabled="False"/>
                    <Button x:Name="BtnFolder" Style="{StaticResource Btn}" Content="Afficher dans le dossier" Click="OnShowFolder" IsEnabled="False"/>
                    <Button x:Name="BtnNotice" Style="{StaticResource Btn}" Content="Ouvrir l'avis" Click="OnOpenNotice" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock Grid.Row="3" x:Name="SnippetBlock" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox Grid.Row="4" x:Name="FilesBox" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource BorderBrushSoft}" Padding="6"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
